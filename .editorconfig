root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{rs,toml}]
indent_size = 4

[*.{yml,yaml,json,js,ts,css,html}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.ps1]
indent_size = 4
end_of_line = crlf

[*.sh]
indent_size = 4
end_of_line = lf

[Makefile]
indent_style = tab
